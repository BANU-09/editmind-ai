# ==============================================================================
# EDITMIND AI — Environment Configuration Template
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini speech recognition, verification, translation & prompt planning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HTTP Server Port (must remain 3000 in AI Studio preview)
PORT=3000

# Frontend -> Backend API Base URL (optional; leave empty for same-origin, or set to worker URL on Vercel)
VITE_API_BASE_URL=""

# CORS allowed origins (comma-separated, e.g. "https://editmind.vercel.app,http://localhost:3000" or "*")
CORS_ORIGIN="*"

# ------------------------------------------------------------------------------
# Media Intake & Upload Limits
# ------------------------------------------------------------------------------
# Strictly enforced 2 GB cap (2147483648 bytes) across file upload and URL import.
MAX_UPLOAD_BYTES=2147483648
ALLOWED_MEDIA_FORMATS="mp4,webm,mov,mkv,ogv,m4v"
URL_IMPORT_TIMEOUT_MS=180000
URL_IMPORT_MAX_REDIRECTS=5
ALLOW_PRIVATE_URL_IMPORTS=0

# ------------------------------------------------------------------------------
# Configurable Speech Recognition, Verification & Translation Adapters
# ------------------------------------------------------------------------------
# STT_PROVIDER: auto | gemini | whisper | mock
# Commercial Licensing Note:
#   - gemini-3.5-transcribe / gemini-4-hydrogen: Google Gemini API (commercial ToS)
#   - @huggingface/transformers & Xenova/whisper-base: Apache-2.0 / MIT (commercial-safe local fallback)
STT_PROVIDER="auto"
FORCE_LOCAL_STT=0
STT_GEMINI_MODEL="gemini-3.5-transcribe"
STT_WHISPER_MODEL="Xenova/whisper-base"
VERIFY_MODEL="gemini-4-hydrogen"
LANG_DETECT_MODEL="gemini-4-hydrogen"
TRANSLATE_MODEL="gemini-4-hydrogen"
EDIT_PLANNER_MODEL="gemini-4-hydrogen"
STT_VERIFY_PASS=1

# ------------------------------------------------------------------------------
# Disk-Streamed Chunking, Concurrency & Retries (supports 60-minute videos)
# ------------------------------------------------------------------------------
AUDIO_CHUNK_TARGET_SEC=24
AUDIO_CHUNK_MIN_SEC=12
AUDIO_CHUNK_MAX_SEC=30
AUDIO_CHUNK_OVERLAP_SEC=1.25
STT_CONCURRENCY=2
STT_RETRY_COUNT=3
STT_TIMEOUT_MS=35000

# ------------------------------------------------------------------------------
# Persistent Storage, Vercel Blob & Separate Cloud Run Background Worker
# ------------------------------------------------------------------------------
STORAGE_DIR="storage"
TEMP_MEDIA_DIR=""
HF_CACHE_DIR=""
MULTIPART_CHUNK_BYTES=8388608

# Vercel Blob (persistent media, thumbnails, music & MP4 export storage up to 2 GB)
BLOB_READ_WRITE_TOKEN=""

# Separate Background Worker (e.g. Google Cloud Run container running WORKER_MODE=1)
WORKER_MODE=0
WORKER_URL=""
WORKER_SHARED_SECRET=""
WORKER_CALLBACK_BASE_URL=""
PUBLIC_WORKER_URL=""

# Durable session API and Compose (one API/SQLite worker process per data volume).
API_WRITES_PER_MINUTE=180
JOB_POLL_MS=400
EDITMIND_PORT=3000
WARM_DEMO_LIBRARY=1
# Set a known hourly price to populate the per-job wall-time compute estimate.
COMPUTE_USD_PER_HOUR=""
EDITMIND_RELEASE=""
# Leave S3_BUCKET empty for filesystem artifacts. The Compose file supplies an
# internal S3 service. With an existing bucket, give the service's AWS identity
# read/write permission for results/* and permission to check bucket readiness.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=us-east-1
S3_CREATE_BUCKET=0
# Optional completion callbacks. Use exact HTTPS destinations and a private secret.
CALLBACK_ALLOWED_URLS=""
CALLBACK_HMAC_SECRET=""
CALLBACK_ALLOW_HTTP=0

# Optional media, assistant, gateway, and runner settings. Vercel supplies
# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL; Windows supplies WINDIR.
ANALYSIS_AUDIO_DIR=""
DEMO_FONT_FILE=""
EDITMIND_MEDIA_RELEASE=""
EDITMIND_PLANNER_URL=""
EDITMIND_PUBLIC_ORIGIN=""
EDITMIND_API_URL=""
EDITMIND_GUEST_ID=""
EDITMIND_ACCESS_TOKEN=""
# Loopback URL imports and scripted transcription are for local test fixtures.
ALLOW_LOCALHOST_URL_IMPORT_FOR_TEST=0
MOCK_STT_TEXT=""
# AWS credentials can be injected through the SDK credential chain or workload
# identity. Leave unset on the host when using Compose's isolated demo storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Dedicated external bucket credentials for the optional hosted media sandbox.
# These are only passed through when S3_BUCKET is explicitly configured.
# EDITMIND_S3_ACCESS_KEY_ID=
# EDITMIND_S3_SECRET_ACCESS_KEY=
# EDITMIND_S3_SESSION_TOKEN=
