{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:editmind:project-timeline:1",
  "title": "EditMind project timeline v1",
  "description": "A single-media, non-destructive edit. Intervals are half-open and expressed in seconds. Source values remain attached to the original recording. Segment array order is playback order.",
  "type": "object",
  "required": [
    "mediaId",
    "segments",
    "duration",
    "captionsEnabled",
    "captionStyle",
    "captions",
    "overlays",
    "bleeps",
    "audio",
    "trackVisibility",
    "trackLocks",
    "protectedMomentIds"
  ],
  "properties": {
    "mediaId": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 1
    },
    "captionsEnabled": {
      "type": "boolean"
    },
    "captionStyle": {
      "$ref": "#/$defs/style"
    },
    "captions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caption"
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "bleeps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audioRange"
      }
    },
    "muteRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audioRange"
      }
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "trackLocks": {
      "$ref": "#/$defs/tracks"
    },
    "trackVisibility": {
      "$ref": "#/$defs/tracks"
    },
    "protectedMomentIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protectedPauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRange"
      }
    },
    "activeVersionId": {
      "type": "string"
    }
  },
  "$defs": {
    "sourceRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "audioRange": {
      "type": "object",
      "required": [
        "id",
        "sourceStart",
        "sourceEnd",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string"
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "sourceSegmentId",
        "sourceStart",
        "sourceEnd",
        "timelineStart",
        "timelineEnd",
        "speed",
        "volume",
        "muted",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceSegmentId": {
          "type": "string"
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "number",
          "minimum": 0
        },
        "timelineStart": {
          "type": "number",
          "minimum": 0
        },
        "timelineEnd": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "muted": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "thumbnailUrl": {
          "type": "string"
        },
        "transition": {
          "enum": [
            "none",
            "fade",
            "crossfade"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "crop": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "word": {
      "type": "object",
      "required": [
        "id",
        "word",
        "start",
        "end",
        "speaker"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "word": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "normalizedText": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "number",
          "minimum": 0
        },
        "speaker": {
          "type": "string"
        },
        "speakerId": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timingAccuracy": {
          "enum": [
            "model-word",
            "aligned",
            "approximate"
          ]
        },
        "isFiller": {
          "type": "boolean"
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "review_needed",
            "unclear_audio"
          ]
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "fontFamily",
        "fontSize",
        "color",
        "backgroundColor",
        "position",
        "highlightActiveWord",
        "highlightColor"
      ],
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "mode": {
          "enum": [
            "sentence",
            "word"
          ]
        },
        "highlightActiveWord": {
          "type": "boolean"
        },
        "highlightColor": {
          "type": "string"
        }
      }
    },
    "stylePatch": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "mode": {
          "enum": [
            "sentence",
            "word"
          ]
        },
        "highlightActiveWord": {
          "type": "boolean"
        },
        "highlightColor": {
          "type": "string"
        }
      }
    },
    "caption": {
      "type": "object",
      "required": [
        "id",
        "sourceStart",
        "sourceEnd",
        "text",
        "visible",
        "words"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceSegmentId": {
          "type": "string"
        },
        "speakerId": {
          "type": "string"
        },
        "sourceStart": {
          "type": "number",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "customText": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "styleOverride": {
          "$ref": "#/$defs/stylePatch"
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "id",
        "text",
        "timelineStart",
        "timelineEnd",
        "x",
        "y",
        "fontSize",
        "color",
        "backgroundColor"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timelineStart": {
          "type": "number",
          "minimum": 0
        },
        "timelineEnd": {
          "type": "number",
          "minimum": 0
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fontSize": {
          "type": "number",
          "minimum": 0
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "sourceRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRange"
          }
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "masterVolume",
        "muted",
        "noiseReduction",
        "fadeInSec",
        "fadeOutSec",
        "musicEnabled",
        "musicPreset",
        "musicVolume",
        "musicFadeInSec",
        "musicFadeOutSec",
        "audioTrackLocked"
      ],
      "properties": {
        "duckUnderSpeech": {
          "type": "boolean"
        },
        "masterVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "muted": {
          "type": "boolean"
        },
        "noiseReduction": {
          "type": "boolean"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        },
        "musicEnabled": {
          "type": "boolean"
        },
        "musicPreset": {
          "enum": [
            "ambient-pulse",
            "cinematic-pad",
            "upbeat-synth",
            "custom-upload"
          ]
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "musicFadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "musicFadeOutSec": {
          "type": "number",
          "minimum": 0
        },
        "musicStartOffsetSec": {
          "type": "number",
          "minimum": 0
        },
        "musicDurationSec": {
          "type": "number",
          "minimum": 0
        },
        "customMusicUrl": {
          "type": "string"
        },
        "customMusicName": {
          "type": "string"
        },
        "customMusicPath": {
          "type": "string"
        },
        "audioTrackLocked": {
          "type": "boolean"
        }
      }
    },
    "tracks": {
      "type": "object",
      "required": [
        "video",
        "audio",
        "captions",
        "overlays",
        "music"
      ],
      "properties": {
        "video": {
          "type": "boolean"
        },
        "audio": {
          "type": "boolean"
        },
        "captions": {
          "type": "boolean"
        },
        "overlays": {
          "type": "boolean"
        },
        "music": {
          "type": "boolean"
        }
      }
    }
  }
}
